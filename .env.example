# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_your_key_here
IMAGEKIT_PRIVATE_KEY=private_your_key_here

# Motion page — set to enable password protection (leave unset to keep Motion public)
MOTION_ACCESS_PASSWORD=your_motion_password_here
# Optional: separate secret for Motion unlock cookies (defaults to IMAGEKIT_PRIVATE_KEY)
# MOTION_ACCESS_SECRET=
